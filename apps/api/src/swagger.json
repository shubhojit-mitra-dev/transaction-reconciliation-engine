{
  "openapi": "3.0.0",
  "info": {
    "title": "Transaction Reconciliation Engine API",
    "version": "1.0.0",
    "description": "API for ingesting and reconciling internal user transaction ledgers against external exchange records."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current Environment"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Healthcheck",
        "description": "Verifies that the API is running.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/reconcile": {
      "post": {
        "summary": "Upload and reconcile ledgers",
        "description": "Accepts multipart/form-data containing the user and exchange CSV ledgers, runs the reconciliation engine, and returns the result.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "user_file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Internal user transaction ledger (CSV)"
                  },
                  "exchange_file": {
                    "type": "string",
                    "format": "binary",
                    "description": "External exchange transaction ledger (CSV)"
                  },
                  "quantityTolerance": {
                    "type": "number",
                    "description": "Override for quantity tolerance (percentage)",
                    "example": 0.01
                  },
                  "timestampTolerance": {
                    "type": "number",
                    "description": "Override for timestamp tolerance (milliseconds)",
                    "example": 60000
                  }
                },
                "required": ["user_file", "exchange_file"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reconciliation completed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "runId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": ["PENDING", "RUNNING", "COMPLETED", "FAILED"]
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request (e.g., missing files)"
          }
        }
      }
    },
    "/report/{runId}": {
      "get": {
        "summary": "Get full reconciliation report",
        "description": "Retrieves paginated line-by-line reconciliation results for a specific run.",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the reconciliation run"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated results"
          },
          "400": {
            "description": "Invalid runId format"
          },
          "404": {
            "description": "Run not found"
          }
        }
      }
    },
    "/report/{runId}/summary": {
      "get": {
        "summary": "Get run summary",
        "description": "Retrieves aggregated counts of matched, unmatched, and conflicting transactions for a specific run.",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Summary metrics"
          }
        }
      }
    },
    "/report/{runId}/unmatched": {
      "get": {
        "summary": "Get unmatched transactions",
        "description": "Retrieves paginated results filtered specifically for UNMATCHED_USER and UNMATCHED_EXCHANGE statuses.",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated unmatched results"
          }
        }
      }
    }
  }
}
